{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vdl-backend-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // Daily reminders at 02:00 UTC = 07:30 Asia/Colombo
  "triggers": {
    "crons": ["0 2 * * *"]
  },

  // Top level = dev (used by `npm run dev`, `npm run deploy` and tests)
  "vars": {
    "ENVIRONMENT": "development",
    "SUPABASE_URL": "https://bauswallqyrtmngsvpxc.supabase.co",
    "SUPABASE_JWKS_URL": "https://bauswallqyrtmngsvpxc.supabase.co/auth/v1/.well-known/jwks.json",
    "SUPABASE_JWT_ISSUER": "https://bauswallqyrtmngsvpxc.supabase.co/auth/v1",
    "EMAIL_FROM": "Vehicle Doc Lanka <onboarding@resend.dev>"
  },
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 100, "period": 60 }
    },
    {
      "name": "WRITE_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      "name": "STRICT_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 10, "period": 60 }
    }
  ],

  // `vars` and `ratelimits` are not inherited, so production repeats them
  "env": {
    "production": {
      "name": "vdl-backend",
      // Serve prod only from the custom domain: WAF rules (incl. the per-IP rate limit) don't apply
      // to *.workers.dev or preview URLs. Requires the brahmiraj.com zone in this Cloudflare account.
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "vdl-api.brahmiraj.com", "custom_domain": true }],
      "vars": {
        "ENVIRONMENT": "production",
        "SUPABASE_URL": "https://sbqptzedvuqjqgtrdrnt.supabase.co",
        "SUPABASE_JWKS_URL": "https://sbqptzedvuqjqgtrdrnt.supabase.co/auth/v1/.well-known/jwks.json",
        "SUPABASE_JWT_ISSUER": "https://sbqptzedvuqjqgtrdrnt.supabase.co/auth/v1",
        "EMAIL_FROM": "Vehicle Doc Lanka <reminders@mail.brahmiraj.com>"
      },
      "ratelimits": [
        {
          "name": "RATE_LIMITER",
          "namespace_id": "2001",
          "simple": { "limit": 100, "period": 60 }
        },
        {
          "name": "WRITE_RATE_LIMITER",
          "namespace_id": "2003",
          "simple": { "limit": 30, "period": 60 }
        },
        {
          "name": "STRICT_RATE_LIMITER",
          "namespace_id": "2002",
          "simple": { "limit": 10, "period": 60 }
        }
      ]
    }
  }
}
